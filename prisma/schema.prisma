generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  OPEN
  PAID
}

enum AccountType {
  CASH
  BANK
}

enum SplitBillStatus {
  DRAFT
  FINALIZED
}

enum SplitBillPriceMode {
  UNIT_PRICE
  LINE_TOTAL
}

enum SplitBillAdjustmentKind {
  DISCOUNT
  TAX
  SERVICE
  ROUNDING
  OTHER
}

enum SplitBillAdjustmentCalculation {
  FIXED
  PERCENT
}

enum SplitBillAdjustmentBase {
  ITEMS_NET
  RUNNING_TOTAL
  CUSTOM
}

enum SplitBillAdjustmentEffect {
  ADD
  SUBTRACT
  INCLUDED
}

enum SplitBillAdjustmentDistribution {
  PROPORTIONAL
  EQUAL
}

model User {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid())
  username        String    @unique
  name            String
  email           String    @unique
  password        String
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  sessions     Session[]
  categories   Category[]
  transactions Transaction[]
  debts        Debt[]
  accounts     Account[]
  splitBills   SplitBill[]
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        Int             @id @default(autoincrement())
  uuid      String          @unique @default(uuid())
  userId    Int
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      TransactionType
  icon      String?
  color     String?
  createdAt DateTime        @default(now())

  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id            Int             @id @default(autoincrement())
  uuid          String          @unique @default(uuid())
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    Int?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  debtId        Int?
  debt          Debt?           @relation(fields: [debtId], references: [id], onDelete: Cascade)
  debtPaymentId Int?            @unique
  debtPayment   DebtPayment?    @relation(fields: [debtPaymentId], references: [id], onDelete: Cascade)
  accountId     Int?
  account       Account?        @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccountId   Int?
  toAccount     Account?        @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  type          TransactionType
  amount        Decimal         @db.Decimal(14, 2)
  note          String?
  occurredAt    DateTime        @db.Date
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, type])
  @@index([categoryId])
  @@index([debtId])
  @@index([accountId])
  @@index([toAccountId])
}

model Debt {
  id        Int        @id @default(autoincrement())
  uuid      String     @unique @default(uuid())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DebtType
  party     String
  amount    Decimal    @db.Decimal(14, 2)
  note      String?
  dueDate   DateTime?  @db.Date
  date      DateTime?  @db.Date
  status    DebtStatus @default(OPEN)
  settledAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  payments     DebtPayment[]
  transactions Transaction[]

  @@index([userId, status])
  @@index([userId, type])
}

model DebtPayment {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  debtId           Int
  debt             Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount           Decimal  @db.Decimal(14, 2)
  paidAt           DateTime @db.Date
  note             String?
  isOpeningBalance Boolean  @default(false)
  createdAt        DateTime @default(now())

  transaction Transaction?

  @@index([debtId])
}

model Account {
  id             Int         @id @default(autoincrement())
  uuid           String      @unique @default(uuid())
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  color          String?
  bankName       String?
  accountNumber  String?
  description    String?
  balance        Decimal     @default(0) @db.Decimal(18, 2)
  openingBalance Decimal     @default(0) @db.Decimal(18, 2)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions         Transaction[] @relation("TransactionAccount")
  incomingTransactions Transaction[] @relation("TransactionToAccount")

  @@index([userId])
  @@index([userId, type])
}

model SplitBill {
  id                   Int             @id @default(autoincrement())
  uuid                 String          @unique @default(uuid())
  userId               Int
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  merchantName         String?
  receiptNumber        String?
  occurredAt           DateTime        @db.Date
  note                 String?
  currency             String          @default("IDR")
  status               SplitBillStatus @default(DRAFT)
  expectedReceiptTotal Decimal?        @db.Decimal(18, 2)
  itemsSubtotal        Decimal         @default(0) @db.Decimal(18, 2)
  adjustmentTotal      Decimal         @default(0) @db.Decimal(18, 2)
  grandTotal           Decimal         @default(0) @db.Decimal(18, 2)
  version              Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  participants SplitBillParticipant[]
  items        SplitBillItem[]
  adjustments  SplitBillAdjustment[]

  @@index([userId, occurredAt, id])
  @@index([userId, status])
}

model SplitBillParticipant {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  splitBillId Int
  splitBill   SplitBill @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  name        String
  isPayer     Boolean   @default(false)
  sortOrder   Int

  allocations SplitBillItemAllocation[]

  @@index([splitBillId, sortOrder])
}

model SplitBillItem {
  id             Int                @id @default(autoincrement())
  uuid           String             @unique @default(uuid())
  splitBillId    Int
  splitBill      SplitBill          @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  name           String
  quantity       Int
  priceMode      SplitBillPriceMode @default(UNIT_PRICE)
  unitPrice      Decimal?           @db.Decimal(18, 2)
  lineTotal      Decimal?           @db.Decimal(18, 2)
  discountAmount Decimal            @default(0) @db.Decimal(18, 2)
  grossAmount    Decimal            @db.Decimal(18, 2)
  netAmount      Decimal            @db.Decimal(18, 2)
  sortOrder      Int

  allocations SplitBillItemAllocation[]

  @@index([splitBillId, sortOrder])
}

model SplitBillItemAllocation {
  id            Int                  @id @default(autoincrement())
  itemId        Int
  item          SplitBillItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participantId Int
  participant   SplitBillParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  quantity      Int
  amount        Decimal              @db.Decimal(18, 2)

  @@unique([itemId, participantId])
  @@index([participantId])
}

model SplitBillAdjustment {
  id           Int                             @id @default(autoincrement())
  uuid         String                          @unique @default(uuid())
  splitBillId  Int
  splitBill    SplitBill                       @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  label        String
  kind         SplitBillAdjustmentKind
  calculation  SplitBillAdjustmentCalculation
  baseMode     SplitBillAdjustmentBase
  effect       SplitBillAdjustmentEffect
  distribution SplitBillAdjustmentDistribution
  rate         Decimal?                        @db.Decimal(9, 4)
  baseAmount   Decimal?                        @db.Decimal(18, 2)
  amount       Decimal                         @db.Decimal(18, 2)
  sortOrder    Int

  @@index([splitBillId, sortOrder])
}
